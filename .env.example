# Groq free tier — same Chat Completions JSON as OpenAI.
# Create a key (no credit card for the free plan): https://console.groq.com/keys
GROQ_API_KEY=gsk_...

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Later, paid OpenAI is the same code with:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
